{
  "name": "swiftcab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run start:dev",
    "qa": "npm run start:qa",
    "stage": "npm run start:stage",
    "start:dev": "env-cmd -f environments/development/.env next dev -p 3000",
    "start:qa": "env-cmd -f environments/qa/.env next dev -p 3000",
    "start:stage": "env-cmd -f environments/stage/.env next dev -p 3000",
    "start:prod": "env-cmd -f environments/prod/.env next start -p 3000",
    "build:dev": "env-cmd -f environments/development/.env next build",
    "build:development": "npm run build:dev",
    "build:qa": "env-cmd -f environments/qa/.env next build",
    "build:stage": "env-cmd -f environments/stage/.env next build",
    "build:prod": "env-cmd -f environments/prod/.env next build",
    "prod": "npm run build:prod && npm run start:prod",
    "run:dev": "npm run start:dev",
    "run:qa": "npm run build:qa && env-cmd -f environments/qa/.env next start -p 3000",
    "run:stage": "npm run build:stage && env-cmd -f environments/stage/.env next start -p 3000",
    "run:prod": "npm run prod",
    "lint": "next lint"
  },
  "dependencies": {
    "@emotion/cache": "11.11.0",
    "@emotion/react": "11.11.1",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.11.0",
    "@headlessui/react": "^1.7.14",
    "@hookform/resolvers": "^5.0.1",
    "@lottiefiles/dotlottie-react": "^0.12.3",
    "@mui/icons-material": "5.15.15",
    "@mui/lab": "5.0.0-alpha.170",
    "@mui/material": "5.15.15",
    "@mui/x-tree-view": "^8.11.0",
    "@reduxjs/toolkit": "^2.5.1",
    "@tabler/icons-react": "2.30.0",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.8.1",
    "@types/axios": "^0.14.0",
    "@types/node": "20.2.1",
    "@types/react": "18.2.6",
    "@types/react-dom": "18.2.4",
    "apexcharts": "3.41.1",
    "autoprefixer": "10.4.14",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "cookies-next": "^5.1.0",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "env-cmd": "^10.1.0",
    "eslint": "8.46.0",
    "eslint-config-next": "13.4.12",
    "framer-motion": "^12.11.0",
    "lodash": "4.17.21",
    "lucide-react": "^0.510.0",
    "next": "^14.2.3",
    "olamaps-web-sdk": "^1.4.0",
    "postcss": "^8.5.1",
    "react": "^18.2.0",
    "react-apexcharts": "1.4.1",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.5.0",
    "react-helmet-async": "1.3.0",
    "react-hook-form": "^7.56.3",
    "react-mui-sidebar": "^1.3.8",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.3",
    "redux": "^5.0.1",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "3.3.2",
    "typescript": "5.0.4",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@hookform/devtools": "^4.4.0"
  }
}
